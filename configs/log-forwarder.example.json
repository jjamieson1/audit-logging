{
  "server_url": "http://localhost:8080/v1/logs",
  "auth_bearer_token": "replace-with-token",
  "source_file": "./data/audit.log.jsonl",
  "app_name": "payments-api",
  "timestamp_field": "timestamp",
  "parser_mode": "custom",
  "regex_pattern": "",
