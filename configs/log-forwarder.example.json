  "retry_max_backoff_ms": 5000,
  "request_timeout_ms": 10000,
  "dead_letter_path": "./data/log-forwarder.deadletter.jsonl",
  "metrics_port": 9091,
  "metrics_report_interval_ms": 30000,
  "verify_interval_ms": 60000
}
