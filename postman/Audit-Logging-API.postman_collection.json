{
  "info": {
    "name": "Audit Logging API",
    "description": "Postman collection for the tamper-evident audit logging service.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8090"
    },
    {
      "key": "appName",
      "value": "postman-client"
    },
    {
      "key": "level",
      "value": "INFO"
    },
    {
      "key": "message",
      "value": "event created from postman"
    },
    {
      "key": "authToken",
      "value": "alog_replace_me"
    },
    {
      "key": "nextCursor",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{authToken}}", "type": "string" }
    ]
  },
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "auth": { "type": "noauth" },
        "url": {
          "raw": "{{baseUrl}}/v1/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "health"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Write Log",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"app\": \"{{appName}}\",\n  \"level\": \"{{level}}\",\n  \"message\": \"{{message}}\",\n  \"metadata\": {\n    \"source\": \"postman\",\n    \"traceId\": \"trace-001\"\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/v1/logs",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "logs"
          ]
        }
      },
      "response": []
    },
    {
      "name": "List Logs (Paginated)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/logs?limit=50&cursor={{nextCursor}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "logs"
          ],
          "query": [
            {
              "key": "limit",
              "value": "50"
            },
            {
              "key": "cursor",
              "value": "{{nextCursor}}"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "// Store the cursor so re-sending this request fetches the next page.",
              "// A null cursor means the last page; clear it so the next send restarts.",
              "pm.collectionVariables.set('nextCursor', body.nextCursor || '');",
              "pm.test('request was authorized', () => pm.response.code !== 401);"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Filter Logs by App + Level",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/logs?app={{appName}}&level=ERROR&limit=25",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "logs"
          ],
          "query": [
            {
              "key": "app",
              "value": "{{appName}}"
            },
            {
              "key": "level",
              "value": "ERROR"
            },
            {
              "key": "limit",
              "value": "25"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Search Logs (q)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/logs/search?q=timeout&limit=10",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "logs",
            "search"
          ],
          "query": [
            {
              "key": "q",
              "value": "timeout"
            },
            {
              "key": "limit",
              "value": "10"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Verify Chain",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/verify",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "verify"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Invalid Payload Example",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"app\": \"{{appName}}\",\n  \"level\": \"INFO\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/v1/logs",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "logs"
          ]
        }
      },
      "response": []
    }
  ]
}
